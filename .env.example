# OAuth client IDs, read at build time by src-tauri/build.rs. Copy to .env and fill in (docs/setup.md).
# These identify the app to each provider; .env stays out of git all the same.
WANDIKA_GITHUB_CLIENT_ID=
WANDIKA_GOOGLE_DESKTOP_CLIENT_ID=
WANDIKA_GOOGLE_DESKTOP_CLIENT_SECRET=
WANDIKA_GOOGLE_IOS_CLIENT_ID=
WANDIKA_MICROSOFT_CLIENT_ID=
# Apple team that signs the iPhone build (Xcode → Settings → Accounts). Then run
# node scripts/configure-mobile.mjs to write src-tauri/tauri.ios.conf.json.
WANDIKA_APPLE_TEAM=
