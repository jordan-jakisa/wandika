{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "deep-link:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "core:window:allow-set-theme"
  ],
  "platforms": [
    "macOS",
    "iOS",
    "android",
    "windows",
    "linux"
  ]
}
