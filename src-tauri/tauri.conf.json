{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wandika",
  "version": "0.1.0",
  "identifier": "me.jordanjakisa.wandika",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Wandika",
        "width": 1240,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Markdown notes synced through GitHub",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "iOS": {
      "minimumSystemVersion": "17.0",
      "bundleVersion": "2"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "wandika"
        ]
      }
    }
  }
}
